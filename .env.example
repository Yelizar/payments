HOST=0.0.0.0
PORT=8000
WORKERS_COUNT=1
RELOAD=True
COMPOSE_NAME=payments

ECHO=True
DB__PG_DB=payments
DB__PG_USER=payments
DB__PG_PASSWORD=payments
DB__PG_HOST=postgres
